# ---------------------------------------------------------------------------
# Database — TiDB Serverless (MySQL compatible, free tier available)
# https://tidbcloud.com → Create Cluster → Serverless → Connect → copy URL
#
# Option A: connection string (recommended)
DATABASE_URL=mysql://user.root:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/chargebacks?sslaccept=strict

# Option B: individual vars (used if DATABASE_URL is not set)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_user.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=chargebacks
# ---------------------------------------------------------------------------

# Groq — powers the CrewAI agents (OpenAI-compatible, free tier available)
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Composio — submits the dispute PDF via Gmail / Outlook / Stripe API
# https://app.composio.dev → API Keys
COMPOSIO_API_KEY=your_composio_key

# Dispute recipient email (where the PDF gets emailed)
DISPUTE_RECIPIENT_EMAIL=disputes@yourbankprocessor.com

# Skyfire — agent autonomous micro-payments for enrichment API calls
# https://app.skyfire.xyz → API Keys
SKYFIRE_API_KEY=your_skyfire_key
SKYFIRE_API_URL=https://api.skyfire.xyz

# IP Geolocation enrichment (ipinfo.io free tier: 50k req/month)
# https://ipinfo.io/signup
IPINFO_TOKEN=your_ipinfo_token

# Stripe webhook secret — from Stripe Dashboard → Webhooks → signing secret
# Leave blank to skip signature verification (dev/demo mode)
WEBHOOK_SECRET=whsec_...

# Local output directory for generated PDFs
PDF_OUTPUT_DIR=./output
