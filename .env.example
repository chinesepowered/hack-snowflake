# TiDB Serverless (MySQL compatible)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_user.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=chargebacks

# Anthropic (CrewAI backbone)
ANTHROPIC_API_KEY=sk-ant-...

# Composio (tool integrations — email, Stripe API)
COMPOSIO_API_KEY=your_composio_key

# Skyfire (agent autonomous payments for enrichment APIs)
SKYFIRE_API_KEY=your_skyfire_key
SKYFIRE_API_URL=https://api.skyfire.xyz

# IP Geolocation enrichment (e.g. ipinfo.io)
IPINFO_TOKEN=your_ipinfo_token

# Webhook auth
WEBHOOK_SECRET=your_webhook_secret

# Output directory for generated PDFs
PDF_OUTPUT_DIR=./output
